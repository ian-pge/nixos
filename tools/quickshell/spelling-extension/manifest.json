{
  "manifest_version": 3,
  "name": "Correction GPT et Qwen",
  "version": "0.3.0",
  "description": "Alt+Tab : GPT. Ctrl+Alt+Tab : Qwen local. Corrections expliquées dans le panneau IA Quickshell.",
  "key": "",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "editor.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
